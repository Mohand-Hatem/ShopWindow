# ==========================================
# ShopWindow - Environment Configuration
# ==========================================

# Server Port
PORT=3000

# ------------------------------------------
# Supabase PostgreSQL Configuration
# ------------------------------------------
# DATABASE_URL: Transaction-mode connection pooling (port 6543).
# Used by the NestJS app during runtime queries.
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Direct session connection (port 5432).
# Used exclusively by Prisma CLI for migrations and schema introspection.
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------
# Redis Configuration (Local Container)
# ------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------
# Admin Authentication (Temporary Mock)
# ------------------------------------------
ADMIN_SECRET_KEY=shopwindow-super-secret-admin-key
