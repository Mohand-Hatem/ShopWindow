# ==========================================
# ShopWindow — Git Ignore Configuration
# ==========================================

# Explicitly Ignored Documentation (User Requirement)
docs/
docs/*

# Environment and Secret Files
.env
.env.*
!.env.example
*.env

# Dependencies
node_modules/
*/node_modules/

# Build & Compilation Outputs
dist/
*/dist/
build/
*/build/
out/
.next/
*.tsbuildinfo

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test Coverage & Artifacts
coverage/
*/coverage/
.nyc_output/

# Editor & IDE Directories
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Temporary & Local Scratch Files
tmp/
temp/
scratch/
